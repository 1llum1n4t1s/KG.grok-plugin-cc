{
  "compilerOptions": {
    "target": "ES2022",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmitOnError": true,
    "newLine": "lf",
    "useDefineForClassFields": false,
    "noUnusedLocals": true,
    "strict": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "plugins/grok/scripts/**/*.mts",
    "scripts/**/*.mts",
    "tests/**/*.mts",
    "plugins/grok/scripts/lib/acp-protocol.d.ts"
  ]
}
